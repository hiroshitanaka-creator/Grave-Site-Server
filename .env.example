# Shell-compatible example. Copy to .env; set a secret locally. Never commit .env.
API_KEY=REPLACE_WITH_A_LONG_RANDOM_LOCAL_SECRET
MESSAGE_STORE=sqlite
MESSAGE_DB_PATH=data/messages.sqlite3
# Explicitly opt in only after selecting authorized test destinations.
DRIVE_ENABLED=false
CALENDAR_ENABLED=false
# service_account / oauth / adc; this file does not choose your Drive ownership model.
GOOGLE_AUTH_MODE=service_account
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_OAUTH_TOKEN_JSON=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_CALENDAR_ID=
# Firestore uses Application Default Credentials, independent of GOOGLE_AUTH_MODE.
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE='(default)'
FIRESTORE_COLLECTION=grave_messages
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
